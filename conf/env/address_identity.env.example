# BTC-first address identity runtime. Do not add a provider token to this file.
CAI_DATABASE_PATH=data/identity/address_identity.sqlite3
CAI_RAW_PAYLOAD_ROOT=data/raw/0xrouter
CAI_EXPORT_ROOT=data/exports
CAI_ENABLED_CHAINS=bitcoin
CAI_0XROUTER_BASE_URL=https://0xrouter.app
# CAI_0XROUTER_TOKEN is environment-only and required only for execute-mode fetches.
CAI_0XROUTER_REQUESTS_PER_MINUTE=20
CAI_0XROUTER_RESPONSE_BYTES_BUDGET=10485760
CAI_HTTP_TIMEOUT_SECONDS=30
CAI_0XROUTER_MAX_TRANSPORT_RETRIES=1
CAI_DISCOVERY_TTL_HOURS=168
CAI_DETAIL_TTL_HOURS=720
CAI_MAX_DETAIL_CANDIDATES_PER_RUN=100

# Coverage-driven BTC synchronization over the 0xRouter Chaindata surface.
# This is intentionally below the provider's 30 requests/minute limit.
CAI_CHAINDATA_COVERAGE_REQUESTS_PER_MINUTE=25
# 50 MiB local response budget per run; the runtime reports an estimated points cost.
CAI_CHAINDATA_COVERAGE_RESPONSE_BYTES_BUDGET=52428800
CAI_CHAINDATA_COVERAGE_ADDRESS_TTL_HOURS=336
CAI_CHAINDATA_COVERAGE_ENTITY_TTL_HOURS=720
# Avoid repeatedly spending requests on an upstream prediction endpoint failure.
CAI_CHAINDATA_COVERAGE_PREDICTION_RETRY_BACKOFF_MINUTES=60
# Eight entities reserve seven requests for direct address enrichment at 25/min:
# 2 discovery + (8 * detail/prediction) + 7 addresses = 25 requests.
CAI_CHAINDATA_COVERAGE_MAX_ENTITIES_PER_RUN=8
CAI_CHAINDATA_COVERAGE_MAX_ADDRESSES_PER_RUN=100
